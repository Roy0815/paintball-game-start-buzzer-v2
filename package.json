{
  "name": "paintball-game-start-buzzer-v2",
  "version": "0.1.0",
  "description": "PWA: Bluetooth-Medienfernbedienung löst eigene Sounds auf einem Bluetooth-Lautsprecher aus.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run licenses && vite build && npm run docs:build",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs-src --port 5174",
    "docs:build": "vitepress build docs-src",
    "docs:preview": "vitepress preview docs-src",
    "icons": "node scripts/generate-icons.mjs",
    "licenses": "node scripts/generate-licenses.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "^1.6.4",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "idb": "^8.0.4"
  }
}
